# ==========================================
# RECICLAHUB - CONFIGURACOES DE AMBIENTE
# ==========================================

# ORACLE DATABASE
# Senha do usuario administrador do Oracle
ORACLE_PASSWORD=SUBSTITUIR_SENHA_ADMIN

# Usuario utilizado pela aplicacao
ORACLE_APP_USER=reciclahub
ORACLE_APP_PASSWORD=SUBSTITUIR_SENHA_APLICACAO

# Porta externa do Oracle
ORACLE_PORT=1522

# API SPRING BOOT
# Porta externa da API principal
API_PORT=8080

# AUTENTICACAO JWT
# Chave secreta utilizada para assinar os tokens
JWT_SECRET=SUBSTITUIR_POR_CHAVE_SECRETA_SEGURA

# Expiracao do token em milissegundos (1 hora)
JWT_EXPIRATION_MS=3600000